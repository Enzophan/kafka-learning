{
  "name": "order-app",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "clean": "rm -rf dist",
    "kafka:up": "docker compose up -d"
  },
  "keywords": [
    "orders",
    "api",
    "typescript",
    "nodejs"
  ],
  "author": "",
  "license": "ISC",
  "description": "A minimal Order API built with Node.js and TypeScript",
  "dependencies": {
    "express": "^4.18.2",
    "kafkajs": "^2.2.4",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/uuid": "^9.0.1",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.2"
  }
}
